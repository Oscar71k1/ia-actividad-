# Proveedor generativo: ollama (local, por defecto) o groq (nube).
# GENERATIVE_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000

# --- Groq (nube) ---
# Para usar Groq: descomente GENERATIVE_PROVIDER=groq y pegue su clave solo en .env.
# GENERATIVE_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=60000

# Puerto opcional de la API
# PORT=3000
